#!/bin/bash
set -uo pipefail
url="${LINT4_URL:-https://dev.sapiens4.ai/lint4}"
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue
  base="$remote"
  [ "$base" = "$zero" ] && base=$(for b in origin/dev origin/main; do
    m=$(git merge-base "$b" "$local" 2>/dev/null) && echo "$(git rev-list --count "$m".."$local") $m" || true; done | sort -n | head -1 | cut -d' ' -f2)
  report=$(git -c core.quotePath=false diff --no-color --unified=100000 "$base" "$local" \
    | curl -sS --compressed --max-time 60 --data-binary @- "$url/diff") || { echo "lint4: service unreachable, push allowed"; continue; }
  if ! outcome=$(jq -er .outcome <<< "$report" 2>/dev/null); then
    jq -r '.error // .' <<< "$report" 2>/dev/null | sed 's/^/lint4: /'
    continue
  fi
  jq -r '.findings[] | "\(.severity)\t\(.path):\(.line):\(.column)\t\(.rule)\n\t\(.snippet)\n\t\(.why). \(.fix)"' <<< "$report"
  jq -r '.errors[] | "error\t\(.path)\t\(.message)"' <<< "$report"
  echo "lint4: $outcome"
  [ "$outcome" = passed ] || status=1
done
[ "$status" = 0 ] || echo "lint4: push stopped; fix the findings above or push with --no-verify"
exit $status
