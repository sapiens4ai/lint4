#!/bin/bash
set -uo pipefail
export HOME=/tmp
RESPONSE_LIMIT=5500000
api="http://$AWS_LAMBDA_RUNTIME_API/2018-06-01/runtime/invocation"

message() { jq -n -c --arg error "$1" '{error: $error}' > body; }

lint() {
  timeout "$LINTER_TIMEOUT" linter check "$@" > body 2> stderr
  case $? in
    0 | 1) status=200; [[ -s body ]] || { status=500; message "$(tail -c 2000 stderr)"; } ;;
    2) status=200; [[ -s body ]] || { status=400; message "$(tail -c 2000 stderr)"; } ;;
    124) status=504; message "check timed out after ${LINTER_TIMEOUT}s" ;;
    *) status=500; message "$(tail -c 2000 stderr)" ;;
  esac
}

payload() {
  if jq -e '.isBase64Encoded == true' event > /dev/null; then jq -j '.body // ""' event | base64 -d > "$1" 2> /dev/null
  else jq -j '.body // ""' event > "$1"; fi
}

check() {
  status=400
  allow='{}'
  if [[ -z "${LINT4_ORIGIN_SECRET:-}" || "$(jq -r '.headers["x-lint4-origin"] // ""' event)" != "$LINT4_ORIGIN_SECRET" ]]; then
    status=403; message "forbidden"; return
  fi
  if [[ "$(jq -r '.requestContext.http.method // ""' event)" != POST ]]; then
    status=405; allow='{"allow": "POST"}'; message "method not allowed: use POST"; return
  fi
  case "$(jq -r '.rawPath // "/"' event)" in
    /diff)
      payload changes.diff
      [[ -s changes.diff ]] || { message "send the full-context diff file as the request body"; return; }
      lint --diff - < changes.diff ;;
    /full)
      payload source.zip
      [[ -s source.zip ]] || { message "send the zip file as the request body"; return; }
      lint --archive source.zip ;;
    *) message "POST /diff with a full-context diff file, or POST /full with a zip file" ;;
  esac
}

plain() {
  jq -n --argjson status "$status" --argjson allow "$allow" --rawfile body body \
    '{statusCode: $status, headers: ({"content-type": "application/json"} + $allow), body: $body}' > response
}

respond() {
  if jq -e '.headers["accept-encoding"] // "" | test("gzip")' event > /dev/null; then
    gzip -c body | base64 -w 0 > packed
    jq -n --argjson status "$status" --argjson allow "$allow" --rawfile body packed \
      '{statusCode: $status, isBase64Encoded: true, headers: ({"content-type": "application/json", "content-encoding": "gzip"} + $allow), body: $body}' \
      > response
  else
    plain
    if (( $(wc -c < response) > RESPONSE_LIMIT )); then
      status=413; message "report too large; resend with Accept-Encoding: gzip"; plain
    fi
  fi
  curl -sS -X POST "$api/$id/response" --data-binary @response > /dev/null
}

while true; do
  work=$(mktemp -d) && cd "$work"
  curl -sS -D headers -o event "$api/next"
  id=$(tr -d '\r' < headers | awk -F': ' 'tolower($1) == "lambda-runtime-aws-request-id" {print $2}')
  check
  respond
  cd / && rm -rf "$work"
done
