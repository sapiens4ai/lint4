#!/bin/bash
set -uo pipefail
export HOME=/tmp
api="http://$AWS_LAMBDA_RUNTIME_API/2018-06-01/runtime/invocation"

message() { jq -n -c --arg error "$1" '{error: $error}' > body; }

lint() {
  timeout "$LINTER_TIMEOUT" linter check "$@" > body 2> stderr
  case $? in
    0 | 1) status=200; [[ -s body ]] || { status=500; message "$(tail -c 2000 stderr)"; } ;;
    2) status=200; [[ -s body ]] || { status=400; message "$(tail -c 2000 stderr)"; } ;;
    124) status=504; message "check timed out after ${LINTER_TIMEOUT}s" ;;
    *) status=500; message "$(tail -c 2000 stderr)" ;;
  esac
}

payload() {
  if jq -e '.isBase64Encoded == true' event > /dev/null; then jq -j '.body // ""' event | base64 -d > "$1" 2> /dev/null
  else jq -j '.body // ""' event > "$1"; fi
}

check() {
  status=400
  case "$(jq -r '.rawPath // "/"' event)" in
    /diff)
      payload changes.diff
      [[ -s changes.diff ]] || { message "send the full-context diff file as the request body"; return; }
      lint --diff - < changes.diff ;;
    /full)
      payload source.zip
      [[ -s source.zip ]] || { message "send the zip file as the request body"; return; }
      lint --archive source.zip ;;
    *) message "POST /diff with a full-context diff file, or POST /full with a zip file" ;;
  esac
}

while true; do
  work=$(mktemp -d) && cd "$work"
  curl -sS -D headers -o event "$api/next"
  id=$(tr -d '\r' < headers | awk -F': ' 'tolower($1) == "lambda-runtime-aws-request-id" {print $2}')
  check
  jq -n --argjson status "$status" --rawfile body body \
    '{statusCode: $status, headers: {"content-type": "application/json"}, body: $body}' |
    curl -sS -X POST "$api/$id/response" --data-binary @- > /dev/null
  cd / && rm -rf "$work"
done
